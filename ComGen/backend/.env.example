# Razorpay API Keys (Test Mode)
# Get your keys from: https://dashboard.razorpay.com/app/website-app-settings/api-keys

# STEP 1: Go to Razorpay Dashboard → Settings → API Keys
# STEP 2: Generate Test Keys
# STEP 3: Copy and paste your keys below (remove 'your_key_here' placeholders)

RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Server Configuration
PORT=5000
NODE_ENV=development

# IMPORTANT NOTES:
# 1. Never commit .env file to Git (already in .gitignore)
# 2. For production, use live keys: rzp_live_xxxxx
# 3. Keep Key Secret secure and never expose to frontend
# 4. Test keys start with: rzp_test_
# 5. Live keys start with: rzp_live_

# Example (DO NOT USE - these are fake):
# RAZORPAY_KEY_ID=rzp_test_1234567890abcd
# RAZORPAY_KEY_SECRET=1234567890abcdefghijklmnop
